ANALYTICS_HOST=127.0.0.1
ANALYTICS_PORT=4567
ANALYTICS_AUTO_CRAWL=true
ANALYTICS_CRAWL_INTERVAL_MS=21600000
ANALYTICS_HEADLESS=true
ANALYTICS_LISTINGS_PER_AREA=10
# 0 means every Tehran area returned by Divar; set 3 for a quick test crawl.
ANALYTICS_MAX_AREAS=0
# Safety ceiling across the complete area queue.
ANALYTICS_MAX_LISTINGS=10000
ANALYTICS_JSON_SNAPSHOT_EVERY=25
ANALYTICS_DETAIL_CONCURRENCY=3
ANALYTICS_NAVIGATION_TIMEOUT_MS=60000
ANALYTICS_PUBLIC_REQUEST_INTERVAL_MS=1500
ANALYTICS_MAX_SEARCH_ITERATIONS=150
ANALYTICS_MAX_SEARCH_STALLS=5
ANALYTICS_MIN_SPATIAL_SAMPLE=5
ANALYTICS_SPATIAL_CELL_SIZE_METERS=1000
ANALYTICS_MIN_MODEL_SAMPLE=30
ANALYTICS_LOG_LEVEL=debug
