{
  "name": "owjcrawler",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "node --test test/*.test.js",
    "start": "node scripts/start-all.js",
    "start:crawler": "node src/index.js",
    "test:crawler:phones": "CRAWL_MODE=latest MAX_LISTINGS=3 DETAIL_CONCURRENCY=1 GENERATE_COMBINED_JSON=false node src/index.js",
    "start:bot": "npm --prefix owj-token-bot start",
    "start:analytics": "npm --prefix owj-market-analytics start",
    "start:analytics-dashboard": "npm --prefix owj-market-analytics start",
    "dev:analytics-dashboard": "npm --prefix owj-market-analytics run dashboard:dev",
    "build:analytics-dashboard": "npm --prefix owj-market-analytics run dashboard:build",
    "score:analytics": "npm --prefix owj-market-analytics run score",
    "test:analytics": "npm --prefix owj-market-analytics test",
    "session-lab": "npm --prefix session-lab run session-lab",
    "session-lab:report": "npm --prefix session-lab run session-lab:report",
    "session-lab:test": "npm --prefix session-lab run session-lab:test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "dotenv": "^17.4.2",
    "playwright": "^1.62.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
